# Gemini API anahtarı (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key

# ComparaAI NestJS backend'inin adresi
NESTJS_BACKEND_URL=http://localhost:3000

# Redis (docker-compose'daki redis servisi)
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Opsiyonel: app/ai/client.py ve app/ai/cache.py'deki varsayılanları geçersiz kılar ---
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_TIMEOUT_MS=30000
# GEMINI_MAX_RETRIES=3
# AI_CACHE_TTL_SECONDS=86400
# AI_USAGE_LOG_DIR=logs

# NOT: Bu servis şu an Gemini kullanıyor; Supabase'e taşındığında (Faz 1/8)
# ai_usage_logs / ai_cache tabloları için SUPABASE_URL ve SUPABASE_SERVICE_ROLE_KEY
# buraya eklenecek.
